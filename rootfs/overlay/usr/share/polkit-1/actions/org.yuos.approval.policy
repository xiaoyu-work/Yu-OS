<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Yu OS</vendor>
  <vendor_url>https://github.com/xiaoyu-work/Yu-OS</vendor_url>

  <action id="org.yuos.approval.decide">
    <description>Confirm a Yu OS permission decision</description>
    <message>Enter your sign-in password to confirm your choice in Yu OS.</message>
    <defaults>
      <!-- WSL and headless terminals may have no local logind seat/session.
           The fixed helper still authenticates the caller and binds decisions
           to PKEXEC_UID; never grant or cache authorization without authentication. -->
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/yuos-approval-helper</annotate>
  </action>

  <action id="org.yuos.approval.administrator">
    <description>Allow a third-party app to use a system permission</description>
    <message>An administrator password is required to let a third-party app use a system permission.</message>
    <defaults>
      <!-- Like Windows UAC: the administrator copy of the fixed helper tells the
           root broker an administrator authenticated this decision. Never cached. -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/yuos-admin-approval-helper</annotate>
  </action>
</policyconfig>
