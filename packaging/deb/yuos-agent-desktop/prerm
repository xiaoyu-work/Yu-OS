#!/bin/sh
# yuos-agent-desktop prerm -- downgrade gate for the graphical Agent.
set -e

DPKG_ROOT="${DPKG_ROOT:-}"
ROOT_ARG="${DPKG_ROOT:-/}"
SECURITY_HELPER="$DPKG_ROOT/usr/lib/yuos/bin/yuos-security-floor"

case "$1" in
    upgrade)
        if [ -x "$SECURITY_HELPER" ] && [ -n "$2" ]; then
            "$SECURITY_HELPER" check-incoming \
                --root "$ROOT_ARG" \
                --package yuos-agent-desktop \
                --version "$2"
        fi
        ;;
    remove|deconfigure|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
