#!/bin/sh
# yuos-framework postinst -- initialize and start the Yu OS Framework platform services.

set -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v identity_finalize >/dev/null 2>&1 &&
    [ -f "$SCRIPT_DIR/extension-identities.sh" ]; then
    . "$SCRIPT_DIR/extension-identities.sh"
fi

DPKG_ROOT="${DPKG_ROOT:-}"
ROOT_ARG="${DPKG_ROOT:-/}"
SECURITY_HELPER="$DPKG_ROOT/usr/lib/yuos/bin/yuos-security-floor"
RELEASE_MANIFEST="$DPKG_ROOT/usr/lib/yuos/release-security/yuos-framework/manifest.json"
RELEASE_SIGNATURE="$RELEASE_MANIFEST.asc"

enable_if_previously_enabled() {
    unit="$1"
    deb-systemd-helper unmask "$unit" >/dev/null || true
    if deb-systemd-helper --quiet was-enabled "$unit"; then
        deb-systemd-helper enable "$unit" >/dev/null || true
    else
        deb-systemd-helper update-state "$unit" >/dev/null || true
    fi
}

# Advance the update-security floor only after the package's own files
# are on disk with the content its signed release manifest declares. A
# partial or failed unpack therefore cannot record a success, and the
# floor is committed *before* any service starts so the daemon's own
# startup check sees the release it is about to run.
commit_security_floor() {
    if [ ! -x "$SECURITY_HELPER" ] || [ ! -f "$RELEASE_MANIFEST" ]; then
        echo "error: yuos-framework is missing its update-security metadata" >&2
        return 1
    fi
    if [ -f "$RELEASE_SIGNATURE" ]; then
        "$SECURITY_HELPER" commit \
            --root "$ROOT_ARG" \
            --package yuos-framework \
            --version "__VERSION__" \
            --manifest "$RELEASE_MANIFEST" \
            --signature "$RELEASE_SIGNATURE" \
            --reason "yuos-framework configure"
    else
        "$SECURITY_HELPER" commit \
            --root "$ROOT_ARG" \
            --package yuos-framework \
            --version "__VERSION__" \
            --manifest "$RELEASE_MANIFEST" \
            --reason "yuos-framework configure"
    fi
}

# During an ordered multi-package transaction the installed set can be
# legitimately mixed for a moment. Starting the broker into that window
# would run new and old protocol peers together, so the start is
# deferred to whichever package is configured last.
security_set_is_runnable() {
    [ -x "$SECURITY_HELPER" ] || return 1
    "$SECURITY_HELPER" service-gate \
        --root "$ROOT_ARG" \
        --package yuos-framework \
        --manifest "$RELEASE_MANIFEST" >/dev/null 2>&1
}

case "$1" in
    configure)
        if [ -z "$DPKG_ROOT" ]; then
            command -v identity_finalize >/dev/null 2>&1 || {
                echo "error: yuos-framework identity policy is unavailable" >&2
                exit 1
            }
            if [ -n "$2" ]; then
                identity_provision upgrade "$2"
            else
                identity_provision install
            fi
            if command -v systemd-sysusers >/dev/null 2>&1; then
                systemd-sysusers /usr/lib/sysusers.d/yuos-agent.conf
            elif ! getent group yuos-extension >/dev/null 2>&1; then
                groupadd --system --gid 60999 yuos-extension
            fi
            identity_finalize
        elif command -v systemd-sysusers >/dev/null 2>&1 &&
            [ -f "$DPKG_ROOT/usr/lib/sysusers.d/yuos-agent.conf" ]; then
            systemd-sysusers --root="$DPKG_ROOT"
        fi
        install -d -m 0700 "$DPKG_ROOT/var/lib/yuos" "$DPKG_ROOT/var/log/yuos"
        # Session event journal: the ordered, signed record of session
        # lifecycle and privileged mutations, plus the MAC keys that
        # sign it. Created root-owned and 0700 here so the first daemon
        # start never has to widen anything, and re-asserted on upgrade
        # without touching an existing chain, anchor or key.
        install -d -m 0700 -o root -g root "$DPKG_ROOT/var/lib/yuos/journal"
        install -d -m 0700 -o root -g root "$DPKG_ROOT/var/lib/yuos/journal/keys"
        rmdir "$DPKG_ROOT/var/log/aos" 2>/dev/null || true

        if [ -f "$DPKG_ROOT/etc/bash.bashrc" ] && \
           ! grep -q 'yuos/profile.sh' "$DPKG_ROOT/etc/bash.bashrc"; then
            echo '[ -f /etc/yuos/profile.sh ] && . /etc/yuos/profile.sh' \
                >> "$DPKG_ROOT/etc/bash.bashrc"
        fi

        mkdir -p "$DPKG_ROOT/etc/systemd/user/default.target.wants"
        for unit in yuos-recoll-index.service yuos-semantic.service; do
            ln -sf "/usr/lib/systemd/user/$unit" \
                "$DPKG_ROOT/etc/systemd/user/default.target.wants/$unit"
        done

        rm -f "$DPKG_ROOT/etc/systemd/user/default.target.wants/yuosd.service"

        # The floor is committed before any service is touched, so the
        # daemon's own startup check sees the release it is about to
        # run. This is also the step that publishes the unprivileged
        # runtime view every other Yu OS binary enforces against.
        commit_security_floor
        if [ -d "$DPKG_ROOT/usr/lib/yuos/trust/publishers.d" ]; then
            if [ -n "$DPKG_ROOT" ]; then
                chroot "$DPKG_ROOT" /usr/local/bin/yu --json provenance trust record-system
            else
                /usr/local/bin/yu --json provenance trust record-system
            fi
        fi

        # Service management only applies to the running system. Under
        # DPKG_ROOT — an image build, a staged root, a test — there is
        # no init to talk to, and touching the host's units would be
        # wrong.
        if [ -z "$DPKG_ROOT" ]; then
            if [ -x /usr/bin/deb-systemd-helper ]; then
                enable_if_previously_enabled yuosd.service
                deb-systemd-helper purge yuos-browser.service >/dev/null || true
            fi
            if [ -d /run/systemd/system ]; then
                systemctl --system daemon-reload >/dev/null || true
                systemctl --global daemon-reload >/dev/null 2>&1 || true
                deb-systemd-invoke reload dbus.service >/dev/null ||
                    echo "yuos-framework: reload the system D-Bus configuration before using Nearby Sharing" >&2
                if command -v udevadm >/dev/null 2>&1; then
                    udevadm control --reload >/dev/null 2>&1 ||
                        echo "yuos-framework: reload udev rules before using Nearby Sharing" >&2
                fi
                if systemctl --quiet is-active NetworkManager.service &&
                    command -v nmcli >/dev/null 2>&1; then
                    nmcli general reload conf >/dev/null 2>&1 ||
                        echo "yuos-framework: run nmcli general reload conf before using Nearby Sharing" >&2
                fi
                if security_set_is_runnable; then
                    if [ -n "$2" ]; then
                        # preinst deliberately stopped yuosd before identity
                        # migration, so try-restart would always leave an
                        # enabled service inactive. Respect an administrator
                        # disabling the unit, but restart every enabled install.
                        if deb-systemd-helper --quiet was-enabled yuosd.service; then
                            deb-systemd-invoke start yuosd.service >/dev/null || true
                        fi
                    else
                        deb-systemd-invoke start yuosd.service >/dev/null || true
                    fi
                else
                    echo "yuos-framework: deferring yuosd start until the rest of this" >&2
                    echo "               Yu OS package set is configured" >&2
                fi
            fi
        fi
        ;;
    abort-upgrade)
        if [ -z "$DPKG_ROOT" ] && [ -d "$identity_systemd_dir" ]; then
            deb-systemd-invoke start yuosd.service >/dev/null || true
        fi
        ;;
    abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
