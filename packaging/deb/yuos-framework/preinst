#!/bin/sh

set -e

DPKG_ROOT="${DPKG_ROOT:-}"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v identity_provision >/dev/null 2>&1 ||
    . "$SCRIPT_DIR/extension-identities.sh"

# Before the Framework split, yuos-agent owned yuosd. Taking those files
# over is an upgrade of the running platform, not a fresh install.
takes_over_agent() {
    dpkg-query -S /usr/local/bin/yuosd 2>/dev/null | grep -q '^yuos-agent:'
}

case "$1" in
    install|upgrade)
        if [ -z "$DPKG_ROOT" ] &&
            { [ "$1" = upgrade ] || takes_over_agent; } &&
            [ -d "$identity_systemd_dir" ]; then
            if systemctl --quiet is-active yuos-browser.service; then
                deb-systemd-invoke stop yuos-browser.service >/dev/null
                if systemctl --quiet is-active yuos-browser.service; then
                    echo "yuos-framework: legacy browser service did not retire before upgrade" >&2
                    exit 1
                fi
            fi
            deb-systemd-invoke stop yuosd.service >/dev/null
            if systemctl --quiet is-active yuosd.service; then
                echo "yuos-framework: yuosd.service did not stop before identity migration" >&2
                exit 1
            fi
            if systemctl --quiet is-active yuos-nearby-radio.service; then
                deb-systemd-invoke stop yuos-nearby-radio.service >/dev/null
                if systemctl --quiet is-active yuos-nearby-radio.service; then
                    echo "yuos-framework: nearby radio did not retire before upgrade" >&2
                    exit 1
                fi
            fi
        fi
        ;;
    abort-upgrade)
        if [ -z "$DPKG_ROOT" ]; then
            identity_rollback_pending
        fi
        ;;
    *)
        echo "preinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
