[Unit]
Description=Yu OS Nearby Sharing radio
Documentation=https://github.com/xiaoyu-work/Yu-OS/blob/main/docs/nearby-sharing.md
After=dbus.service NetworkManager.service yuosd.service
PartOf=yuosd.service
Wants=sys-kernel-debug.mount
After=sys-kernel-debug.mount

[Service]
Type=dbus
BusName=io.github.t4t5.Owly
ExecStartPre=/usr/lib/yuos/bin/yuos-security-floor service-gate --package yuos-agent --manifest /usr/lib/yuos/release-security/yuos-agent/manifest.json
ExecStart=/usr/lib/yuos/bin/yuos-nearby-radio
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
RuntimeDirectory=owly
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
InaccessiblePaths=-/var/lib/yuos -/var/log/yuos -/etc/shadow -/etc/gshadow -/etc/ssh
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
