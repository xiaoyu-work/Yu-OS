#!/bin/sh
set -eu

for entry in \
    "en_US.UTF-8 UTF-8" \
    "en_GB.UTF-8 UTF-8" \
    "zh_CN.UTF-8 UTF-8" \
    "zh_TW.UTF-8 UTF-8" \
    "ja_JP.UTF-8 UTF-8" \
    "ko_KR.UTF-8 UTF-8" \
    "de_DE.UTF-8 UTF-8" \
    "fr_FR.UTF-8 UTF-8" \
    "es_ES.UTF-8 UTF-8" \
    "pt_BR.UTF-8 UTF-8" \
    "it_IT.UTF-8 UTF-8" \
    "ru_RU.UTF-8 UTF-8"; do
    if ! grep -qxF "$entry" /etc/locale.gen; then
        printf '%s\n' "$entry" >> /etc/locale.gen
    fi
done
/usr/sbin/locale-gen
if ! grep -qs '^LANG=' /etc/locale.conf; then
    /usr/sbin/update-locale LANG=en_US.UTF-8
fi
