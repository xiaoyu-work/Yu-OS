#!/usr/bin/python3 -I
"""Commit the local image's one-time account setup, never change an existing user."""

import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys
import unicodedata
from zoneinfo import available_timezones


MARKER = Path("/etc/yuos/local-desktop-setup")
FIRST_RUN = MARKER.with_name("first-run")
UPDATES = "/usr/libexec/yuos-updates"
AVATARS = Path("/usr/share/yuos/avatars")
MAX_REQUEST = 256 * 1024
ENV = {"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8"}
ACCOUNT = re.compile(r"[a-z][a-z0-9_-]{0,30}")
RESERVED = {"root", "daemon", "bin", "sys", "sync", "nobody", "greeter", "_greetd"}
INPUT_METHODS = {"pinyin", "mozc", "hangul"}
FIELD = re.compile(r"[a-zA-Z0-9_-]{1,80}\.json")


def system(*command, data=None):
    return subprocess.run(command, input=data, stdin=subprocess.DEVNULL if data is None else None,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=ENV, check=True)


def account_names(value):
    display = unicodedata.normalize("NFC", value.strip())
    if (not display or len(display.encode()) > 256 or any(
        c in ",:" or unicodedata.category(c).startswith("C") for c in value
    )):
        raise ValueError("invalidUsername")
    if ACCOUNT.fullmatch(display):
        login = display
    else:
        ascii_name = unicodedata.normalize("NFKD", display.casefold()).encode("ascii", "ignore").decode()
        login = re.sub(r"[^a-z0-9_-]+", "-", ascii_name).strip("-_")
        if not login:
            login = "yu-" + hashlib.sha256(display.encode()).hexdigest()[:12]
        elif not login[0].isalpha():
            login = "yu-" + login
        login = login[:31]
    if display.casefold() in RESERVED or login in RESERVED:
        raise ValueError("usernameTaken")
    return display, login


def request():
    raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
    if len(raw) > MAX_REQUEST:
        raise ValueError("invalidInput")
    data = json.loads(raw)
    if not isinstance(data, dict) or set(data) != {
        "username", "password", "avatar", "locale", "keyboard", "inputMethod", "zone", "light", "agent", "restart",
    }:
        raise ValueError("invalidInput")
    for key in ("username", "password", "locale", "keyboard", "inputMethod", "zone"):
        if not isinstance(data[key], str):
            raise ValueError("invalidInput")
    data["display"], data["login"] = account_names(data["username"])
    password = data["password"]
    if not 0 < len(password.encode()) <= 256 or any(c in password for c in "\x00\r\n"):
        raise ValueError("invalidPassword")
    avatar = data["avatar"]
    if not isinstance(avatar, str) or avatar and (
        not re.fullmatch(r"[a-z]{1,24}", avatar) or not (AVATARS / f"{avatar}.png").is_file()
    ):
        raise ValueError("invalidAvatar")
    if type(data["light"]) is not bool or type(data["restart"]) is not bool:
        raise ValueError("invalidInput")
    layouts = {"us", "gb", "de", "fr", "es", "it", "br", "jp", "ru"}
    locales = system("locale", "-a").stdout.decode().splitlines()
    locale = data["locale"]
    method = data["inputMethod"]
    if (data["keyboard"] not in layouts or "_" not in locale
            or not locale.endswith(".utf8") or locale not in locales
            or method and (method not in INPUT_METHODS or data["keyboard"] != "us"
                           or not Path(f"/usr/share/fcitx5/inputmethod/{method}.conf").is_file())
            or data["zone"] not in available_timezones()):
        raise ValueError("invalidRegionalSettings")
    agent = data["agent"]
    if agent is not None and (
        not isinstance(agent, dict) or set(agent) != {"config", "credentials"}
        or not isinstance(agent["config"], dict)
        or not isinstance(agent["credentials"], dict)
        or any(not FIELD.fullmatch(name) or not isinstance(value, dict)
               for name, value in agent["credentials"].items())
    ):
        raise ValueError("invalidAgentSettings")
    return data


def initialize_home(account, data):
    # All home writes happen as the new UID, never as the provisioning process.
    pid = os.fork()
    if pid != 0:
        if os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1]) != 0:
            raise OSError("could not initialize the new home")
        return
    try:
        os.initgroups(account.pw_name, account.pw_gid)
        os.setgid(account.pw_gid)
        os.setuid(account.pw_uid)
        os.umask(0o077)
        home = Path(account.pw_dir)
        config = home / ".config"

        def write(path, content):
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")

        if data["keyboard"] != "us":
            write(config / "hypr/hyprland.lua",
                  'dofile("/etc/xdg/hypr/hyprland.lua")\n'
                  f'hl.config({{input = {{kb_layout = "{data["keyboard"]}"}}}})\n')
        if data["inputMethod"]:
            write(config / "fcitx5/profile",
                  "[Groups/0]\nName=Default\nDefault Layout=us\n"
                  f'DefaultIM={data["inputMethod"]}\n\n'
                  "[Groups/0/Items/0]\nName=keyboard-us\nLayout=\n\n"
                  f'[Groups/0/Items/1]\nName={data["inputMethod"]}\nLayout=\n\n'
                  "[GroupOrder]\n0=Default\n")
        # Set the application theme and full window controls (minimize, maximize, close).
        for gtk in ("gtk-3.0", "gtk-4.0"):
            write(config / gtk / "settings.ini",
                  f'[Settings]\ngtk-application-prefer-dark-theme={int(not data["light"])}\n'
                  'gtk-decoration-layout=appmenu:minimize,maximize,close\n')
        write(config / "net.imput.helium/Default/Preferences",
              json.dumps({
                  "extensions": {"pinned_extensions": ["fclfbhenknddfhcijnlcgamfeeokjekl"]},
                  "helium": {"browser": {"rounded_frame": False}},
              }) + "\n")
        if data["agent"] is not None:
            write(config / "yuos/config.json", json.dumps(data["agent"]["config"]) + "\n")
            directory = home / ".local/share/yuos/credentials/agent"
            for name, value in data["agent"]["credentials"].items():
                write(directory / name, json.dumps(value) + "\n")
    except (OSError, ValueError):
        os._exit(1)
    os._exit(0)


def set_avatar(uid, avatar):
    if not avatar:
        return
    service = "org.freedesktop.Accounts"
    call = ("/usr/bin/busctl", "--system", "--timeout=5s", "call", service)
    system(*call, "/org/freedesktop/Accounts", service, "FindUserById", "x", str(uid))
    system(*call, f"/org/freedesktop/Accounts/User{uid}", service + ".User",
           "SetIconFile", "s", str(AVATARS / f"{avatar}.png"))


def create_owner():
    if (os.getuid() != 0 or os.geteuid() != 0
            or os.environ.get("PKEXEC_UID") != str(pwd.getpwnam("_greetd").pw_uid)):
        raise ValueError("notAvailable")
    fd = os.open(MARKER, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb"):
        marker = os.fstat(fd)
        if marker.st_uid != 0 or not stat.S_ISREG(marker.st_mode) or stat.S_IMODE(marker.st_mode) != 0o644:
            raise ValueError("notAvailable")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if any(1000 <= row.pw_uid < 60000 for row in pwd.getpwall()):
            raise ValueError("notAvailable")
        data = request()
        try:
            system(UPDATES, "setup-admit", "restart" if data["restart"] else "finish")
        except subprocess.CalledProcessError as error:
            print(error.stderr.decode(errors="replace").strip(), file=sys.stderr)
            raise ValueError("updatesPending") from None
        name = data["login"]
        home = Path("/home") / name
        if os.path.lexists(home) or any(row.pw_name == name for row in pwd.getpwall()):
            raise ValueError("usernameTaken")
        system("useradd", "--create-home", "--home-dir", str(home), "--shell", "/bin/bash",
               "--comment", data["display"],
               "--groups", "sudo", "--", name)
        try:
            account = pwd.getpwnam(name)
            if not (1000 <= account.pw_uid < 60000 and account.pw_dir == str(home)):
                raise OSError("unexpected local account")
            initialize_home(account, data)
            locale = data["locale"].removesuffix(".utf8") + ".UTF-8"
            system("/usr/sbin/update-locale", "LANG=" + locale)
            system("timedatectl", "set-timezone", data["zone"])
            # chpasswd uses the OS password stack; the secret never goes in argv.
            try:
                system("chpasswd", data=(name + ":" + data["password"] + "\n").encode())
            except subprocess.CalledProcessError:
                raise ValueError("passwordRejected") from None
            set_avatar(account.pw_uid, data["avatar"])
            if data["restart"] and not FIRST_RUN.is_file():
                # Reopen only the update page for this owner after normal PAM login.
                with FIRST_RUN.open("x") as first_run:
                    os.fchmod(first_run.fileno(), 0o644)
                    first_run.write(f"owner={account.pw_uid}\n")
                    first_run.flush()
                    os.fsync(first_run.fileno())
        except (OSError, ValueError, subprocess.SubprocessError):
            system("userdel", "--remove", "--", name)
            raise
        MARKER.unlink()
    try:
        system("systemctl", "restart", "yuos-home-setup.service")
    except subprocess.SubprocessError:
        print("Yu OS: first owner created, but checkpoint home setup did not restart", file=sys.stderr)
    response = {"finished": True, "login": name}
    if data["restart"]:
        try:
            system(UPDATES, "setup-restart", str(account.pw_uid))
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"Yu OS: first owner created, but the update restart was refused: {error}",
                  file=sys.stderr)
            response["restartFailed"] = True
        else:
            response["restarting"] = True
    return response


if __name__ == "__main__":
    try:
        response = create_owner()
    except ValueError as error:
        code = str(error)
        print(json.dumps({"error": code if code in {
            "notAvailable", "usernameTaken", "invalidInput", "invalidUsername",
            "invalidPassword", "passwordRejected", "invalidAvatar", "invalidRegionalSettings", "invalidAgentSettings",
            "updatesPending",
        } else "invalidInput"}))
    except subprocess.CalledProcessError as error:
        print(f"Yu OS: {error.cmd[0]} failed during local owner setup ({error.returncode})", file=sys.stderr)
        print('{"error":"setupFailed"}')
    except (KeyError, OSError):
        print("Yu OS: local owner setup did not complete", file=sys.stderr)
        print('{"error":"setupFailed"}')
    else:
        print(json.dumps(response))
