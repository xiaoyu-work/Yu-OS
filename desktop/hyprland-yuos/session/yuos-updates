#!/usr/bin/python3 -I
"""Prepare and install only authenticated Yu OS packages, before user login."""

from datetime import datetime, timezone
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import shlex
import stat
import subprocess
import sys
import tempfile
import time


PACKAGES = ("yuos-framework", "yuos-agent", "yuos-base", "yuos-desktop", "yuos-agent-desktop")
# Packages the Framework/Agent split introduced. Earlier systems receive
# them as new installs so the Agent and Desktop's default graphical Agent remain.
SPLIT_PACKAGES = ("yuos-framework", "yuos-agent-desktop")
ROOT = Path("/var/lib/yuos-updates")
STATE = ROOT / "state.json"
POLICY = ROOT / "policy.json"
OFFLINE = Path("/system-update")
OFFLINE_STARTED = Path("/run/yuos-offline-updating")
SOURCE = Path("/etc/apt/sources.list.d/yuos.list")
KEY = "/usr/share/keyrings/yuos-archive-keyring.gpg"
ENV = {"PATH": "/usr/sbin:/usr/bin", "LANG": "C", "DEBIAN_FRONTEND": "noninteractive"}
SETUP = ROOT / "setup.json"
SETUP_DONE = ROOT / "setup-complete"
BOOT_ID = Path("/proc/sys/kernel/random/boot_id")
DRIVER_DIR = Path("/var/lib/yuos/driver-setup")
DRIVER_UNIT = "yuos-driver-online.service"
SETUP_UNIT = "yuos-update-setup.service"
FINISH_PHASES = {"current", "installed", "offline", "failed", "restart-failed"}
JOBS = ("yuos-update-check.service", "yuos-update-prepare.service",
        "yuos-update-automatic.service", "yuos-update-offline.service", SETUP_UNIT)
VERSION = re.compile(r"[0-9][a-zA-Z0-9.+:~\-]*")


def run(*command, capture=False, timeout=120):
    return subprocess.run(command, stdin=subprocess.DEVNULL, text=True, env=ENV,
                          stdout=subprocess.PIPE if capture else None,
                          check=True, timeout=timeout).stdout


def read(path, default):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default


def write(path, data, mode=0o600):
    with tempfile.NamedTemporaryFile(mode="w", dir=ROOT, delete=False) as file:
        staged = Path(file.name)
        try:
            json.dump(data, file)
            file.flush()
            os.fchmod(file.fileno(), mode)
            os.fsync(file.fileno())
            staged.replace(path)
        finally:
            staged.unlink(missing_ok=True)


def ours():
    return OFFLINE.is_symlink() and OFFLINE.readlink() == ROOT


def policy():
    return read(POLICY, {"automatic_updates": False, "automatic_restart": False})


def jobs_busy(*jobs):
    units = run("/usr/bin/systemctl", "show", *jobs, "-p", "ActiveState", "-p", "Job",
                capture=True, timeout=4).splitlines()
    return any(
        line in {"ActiveState=active", "ActiveState=activating", "ActiveState=deactivating"}
        or line.startswith("Job=") and line not in {"Job=", "Job=0"}
        for line in units
    )


def status():
    state = read(STATE, {"phase": "unchecked"})
    # A queued or in-flight operation is not a successful check or install.
    busy = jobs_busy(*JOBS)
    if state["phase"] in {"checking", "downloading", "installing"} and not busy:
        state["phase"] = "interrupted"
    print(json.dumps({"updates": {**state, **policy(), "ready": ours(), "busy": busy}}))


def apt_options():
    # The channel has one explicit keyring. Rebuild the isolated source line
    # rather than accepting trust overrides (for example trusted=yes).
    entries = [line.strip() for line in SOURCE.read_text().splitlines()
               if line.strip() and not line.lstrip().startswith("#")]
    match = re.fullmatch(
        r"deb \[([^\]]+)\] ((?:https://|file:/)\S+) ([a-z0-9-]+) main",
        entries[0] if len(entries) == 1 else "",
    )
    if not match or f"signed-by={KEY}" not in match[1].split() or not Path(KEY).is_file():
        raise ValueError("The signed Yu OS APT channel is not configured")
    source = ROOT / "channel.list"
    source.write_text(f"deb [signed-by={KEY} check-valid-until=yes] {match[2]} {match[3]} main\n")
    source.chmod(0o644)
    (ROOT / "archives").mkdir(exist_ok=True)
    return (
        "-o", f"Dir::Etc::sourcelist={source}", "-o", "Dir::Etc::sourceparts=-",
        "-o", f"Dir::State::lists={ROOT}/lists", "-o", f"Dir::Cache::archives={ROOT}/archives",
        "-o", "Dir::Cache::pkgcache=", "-o", "Dir::Cache::srcpkgcache=",
        "-o", "Acquire::AllowInsecureRepositories=false",
        "-o", "Acquire::AllowDowngradeToInsecureRepositories=false",
        "-o", "Acquire::AllowWeakRepositories=false", "-o", "Acquire::Check-Valid-Until=true",
        "-o", "APT::Get::AllowUnauthenticated=false", "-o", "DPkg::Lock::Timeout=30",
    )


def installed():
    result = subprocess.run(
        ["/usr/bin/dpkg-query", "-W", "-f=${binary:Package} ${db:Status-Abbrev} ${Version}\\n",
         *PACKAGES], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=ENV,
        timeout=5,
    )
    states = {}
    for line in result.stdout.splitlines():
        name, mark, version = line.split()
        if name in PACKAGES and mark in {"ii", "hi"} and VERSION.fullmatch(version):
            states[name] = (version, mark == "hi")
    return states


def split_installs(current):
    """New packages a pre-split installation needs to keep what it already has."""
    needed = []
    if "yuos-agent" in current and "yuos-framework" not in current:
        needed.append("yuos-framework")
    if ("yuos-agent" in current and "yuos-desktop" in current
            and "yuos-agent-desktop" not in current):
        # Desktop recommends its graphical Agent. Like APT, add it only while the
        # installed Desktop predates that recommendation, so a removal sticks.
        recommends = subprocess.run(
            ["/usr/bin/dpkg-query", "-W", "-f=${Recommends}", "yuos-desktop"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=ENV, timeout=5,
        ).stdout
        if not re.search(r"(^|[ ,])yuos-agent-desktop([ ,(]|$)", recommends):
            needed.append("yuos-agent-desktop")
    return needed


def check(state, options):
    state.update(phase="checking", packages=[])
    for key in ("error", "setup_update", "setup_boot", "setup_mutating"):
        state.pop(key, None)
    write(STATE, state)
    run("/usr/bin/apt-get", *options, "-o", "Acquire::Retries=1",
        "-o", "APT::Update::Error-Mode=any", "update", timeout=180)
    current = installed()
    updates = []
    new = split_installs(current)
    for name in PACKAGES:
        if name not in current and name not in new:
            continue
        version, held = current.get(name, (None, False))
        result = run("/usr/bin/apt-cache", *options, "policy", name, capture=True, timeout=15)
        candidate = re.search(r"^  Candidate: (\S+)$", result, re.MULTILINE)
        if candidate and VERSION.fullmatch(candidate[1]) and (version is None or subprocess.run(
            ["/usr/bin/dpkg", "--compare-versions", candidate[1], "gt", version], check=False,
        ).returncode == 0):
            updates.append({"package": name, "installed": version, "version": candidate[1],
                            "held": held})
    state.update(phase="available" if updates else "up-to-date", packages=updates,
                 checked_at=datetime.now(timezone.utc).isoformat(timespec="seconds"))
    write(STATE, state)


def plan(state, options):
    updates = state["packages"]
    if not updates:
        raise ValueError("No checked updates are available")
    if run("/usr/bin/dpkg", "--audit", capture=True, timeout=15).strip():
        raise ValueError("Repair the incomplete dpkg transaction before updating")
    current = installed()
    expected = {}
    for item in updates:
        name, version = item["package"], item["version"]
        if item["installed"] is None:
            if name not in SPLIT_PACKAGES or name in current:
                raise ValueError("An installed version or package hold changed; check again")
        elif (name not in PACKAGES or not VERSION.fullmatch(version)
                or current.get(name) != (item["installed"], False)):
            raise ValueError("An installed version or package hold changed; check again")
        expected[name] = version
    args = ("--no-remove", "--no-install-recommends", "install",
            *(f"{name}={version}" for name, version in expected.items()))
    simulation = run("/usr/bin/apt-get", *options, "--simulate", *args, capture=True)
    unpack = {}
    for line in simulation.splitlines():
        if line.startswith("Inst "):
            match = re.match(r"Inst (\S+) (?:\[[^\]]+\] )?\((\S+) ", line)
            if not match:
                raise ValueError("This update needs a separate administrator APT transaction")
            unpack[match[1]] = match[2]
        elif line.startswith(("Remv ", "Purg ")) or (
            line.startswith("Conf ") and line.split()[1] not in expected
        ):
            raise ValueError("This update needs a separate administrator APT transaction")
    if unpack != expected:
        raise ValueError("The APT plan changes packages outside the checked Yu OS release")
    return args, expected


def clear_archives():
    for file in (ROOT / "archives").glob("*.deb"):
        file.unlink()


def archive_hashes(options, expected):
    packages = [f"{name}={version}" for name, version in expected.items()]
    listing = run("/usr/bin/apt-get", *options, "-o", "Acquire::ForceHash=sha256",
                  "--print-uris", "download", *packages, capture=True, timeout=15)
    hashes = {}
    for line in listing.splitlines():
        _, name, size, digest = shlex.split(line)
        if (not re.fullmatch(r"[A-Za-z0-9_.+%~\-]+\.deb", name)
                or not re.fullmatch(r"SHA256:[0-9a-f]{64}", digest)):
            raise ValueError("The signed APT index did not supply an archive hash")
        hashes[name] = (int(size), digest.removeprefix("SHA256:"))
    if len(hashes) != len(expected):
        raise ValueError("The signed APT index did not supply all selected archives")
    return hashes


def verify_archive(file, name, size, digest):
    if os.fstat(file.fileno()).st_size != size or hashlib.file_digest(file, "sha256").hexdigest() != digest:
        raise ValueError(f"Cached archive does not match the signed APT index: {name}")


def download(options, expected):
    hashes = archive_hashes(options, expected)
    apt = pwd.getpwnam("_apt")
    with tempfile.TemporaryDirectory(prefix="download-", dir=ROOT) as directory:
        os.chown(directory, apt.pw_uid, apt.pw_gid)
        # Unlike install --download-only, download also copies file: archives.
        subprocess.run(
            ["/usr/bin/apt-get", *options, "download",
             *(f"{name}={version}" for name, version in expected.items())],
            stdin=subprocess.DEVNULL, env=ENV, cwd=directory, check=True, timeout=900,
            user=apt.pw_uid, group=apt.pw_gid, extra_groups=(),
        )
        clear_archives()
        for name, (size, digest) in hashes.items():
            source = os.open(Path(directory) / name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(source, "rb") as file, (ROOT / "archives" / name).open("xb+") as archive:
                details = os.fstat(file.fileno())
                if not stat.S_ISREG(details.st_mode) or details.st_size != size:
                    raise ValueError("APT did not materialize a regular archive of the expected size")
                # Copy into Root custody before trusting the downloaded bytes.
                remaining = size + 1
                while remaining and (chunk := file.read(min(remaining, 1024 * 1024))):
                    archive.write(chunk)
                    remaining -= len(chunk)
                archive.seek(0)
                verify_archive(archive, name, size, digest)


def prepare(state, options, *, schedule=True):
    if os.path.lexists(OFFLINE):
        raise ValueError("An offline update is already scheduled")
    _, expected = plan(state, options)
    state.update(phase="downloading")
    state.pop("error", None)
    write(STATE, state)
    download(options, expected)
    plan(state, options)
    state["phase"] = "ready"
    write(STATE, state)
    if schedule:
        OFFLINE.symlink_to(ROOT)


def other_sessions(allowed):
    rows = json.loads(run("/usr/bin/loginctl", "list-sessions", "--json=short",
                          capture=True, timeout=4) or "[]")
    return any(row["session"] != allowed and row["class"] != "greeter"
               for row in rows if not row["class"].startswith("manager"))


def reboot(allowed=None):
    if not ours() or read(STATE, {}).get("phase") != "ready":
        raise ValueError("No offline Yu OS update is ready")
    if other_sessions(allowed):
        raise ValueError("Other users are signed in; restart after they have signed out")
    # systemctl would count the already-confirmed requester as another user.
    # Flag 1 keeps logind's inhibitor check in force for the Root service.
    try:
        run("/usr/bin/busctl", "--system", "--timeout=8s", "--allow-interactive-authorization=no",
            "call", "org.freedesktop.login1", "/org/freedesktop/login1",
            "org.freedesktop.login1.Manager", "RebootWithFlags", "t", "1", timeout=10)
    except subprocess.CalledProcessError:
        raise ValueError("The system blocked the restart. Check for apps preventing restart.") from None


def automatic_restart(settings):
    if not settings["automatic_restart"] or not ours():
        return
    try:
        reboot()
    except (ValueError, subprocess.SubprocessError) as error:
        print(f"Automatic restart deferred: {error}", file=sys.stderr)


def offline(state, options):
    if state.get("phase") != "ready":
        raise ValueError("The prepared update has no confirmed download")
    args, expected = plan(state, options)
    for name, (size, digest) in archive_hashes(options, expected).items():
        with (ROOT / "archives" / name).open("rb") as archive:
            verify_archive(archive, name, size, digest)
    state["phase"] = "installing"
    if state.get("setup_update"):
        state["setup_mutating"] = True
    write(STATE, state)
    environment = {**ENV, "SYSTEMD_OFFLINE": "1"}
    subprocess.run(
        ["/usr/bin/apt-get", *options, "--no-download", "-y",
         "-o", "Dpkg::Options::=--force-confold", *args],
        stdin=subprocess.DEVNULL, env=environment, timeout=1800, check=True,
    )
    after = installed()
    if any(after.get(name) != (version, False) for name, version in expected.items()):
        raise ValueError("APT did not confirm the intended installed versions")
    state.update(phase="installed", packages=[])
    state.pop("setup_mutating", None)
    write(STATE, state)


def setup_status(drivers, software):
    # Only presentation phases leave Root custody, never APT configuration or logs.
    write(SETUP, {"drivers": drivers, "software": software}, mode=0o644)


def coherent_packages(state):
    if state.get("phase") in {"installing", "install-failed"} and (
        not state.get("setup_update") or state.get("setup_mutating")
    ):
        return False
    # Base and Desktop run on the Framework; the official Agent is optional.
    # A pre-split yuos-agent still carries the Framework until it is updated.
    current = set(installed())
    return ({"yuos-base", "yuos-desktop"} <= current
            and bool(current & {"yuos-framework", "yuos-agent"})
            and not run("/usr/bin/dpkg", "--audit", capture=True, timeout=15).strip())


def online():
    try:
        return run("/usr/bin/nmcli", "-g", "CONNECTIVITY", "general",
                   capture=True, timeout=5).strip() == "full"
    except (OSError, subprocess.SubprocessError):
        return False


def setup_drivers():
    setup_status("checking", "waiting")
    pending = DRIVER_DIR / "pending"
    started = pending.is_file() or jobs_busy(DRIVER_UNIT)
    if started:
        setup_status("installing", "waiting")
        try:
            run("/usr/bin/systemctl", "start", DRIVER_UNIT, timeout=10)
            while jobs_busy(DRIVER_UNIT):
                time.sleep(1)
        except subprocess.CalledProcessError:
            print("See the Yu OS driver setup service journal for details", file=sys.stderr)
    info = read(DRIVER_DIR / "status.json", {})
    if info.get("state") == "ready" or not info and not started:
        return "ready"
    # Optional packs (the supported media already include startup drivers) do
    # not become required just because a board has pending audio/GPU features.
    unavailable = not online()
    if info.get("desktop_required") is True:
        return "required-offline" if unavailable else "required-failed"
    return "offline" if unavailable else "failed"


def setup_update(state):
    if SETUP_DONE.is_file():
        return
    previous = read(SETUP, {})
    if previous.get("software") == "restarting":
        if state.get("setup_boot") == BOOT_ID.read_text().strip() and ours():
            return
        # Never start another transaction or reboot after an unconfirmed one.
        software = "installed" if state.get("setup_update") and state.get("phase") == "installed" else "failed"
        if not coherent_packages(state):
            software = "repair"
        setup_status(previous["drivers"], software)
        return

    drivers = setup_drivers()
    if drivers.startswith("required-"):
        setup_status(drivers, "waiting")
        return
    if not coherent_packages(state):
        setup_status(drivers, "repair")
        return
    if os.path.lexists(OFFLINE):
        # Settings or another updater already owns the next boot.
        setup_status(drivers, "failed")
        return
    local_channel = False
    try:
        options = apt_options()
        local_channel = " file:/" in (ROOT / "channel.list").read_text()
        if not local_channel and not online():
            setup_status(drivers, "offline")
            return
        setup_status(drivers, "checking")
        check(state, options)
        if state["phase"] == "up-to-date":
            setup_status(drivers, "current")
            return
        setup_status(drivers, "downloading")
        state["setup_update"] = True
        prepare(state, options, schedule=False)
        setup_status(drivers, "restart")
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"First-run software update: {error}", file=sys.stderr)
        state.update(phase="failed", error="See the Yu OS first-run update service journal")
        write(STATE, state)
        software = "failed" if local_channel or online() else "offline"
        setup_status(drivers, software if coherent_packages(state) else "repair")


def setup_admit(state, action):
    view = read(SETUP, {})
    if (view.get("drivers") not in {"ready", "offline", "failed"}
            or jobs_busy(SETUP_UNIT, DRIVER_UNIT) or not coherent_packages(state)):
        raise ValueError("First-run updates have not settled")
    software = view.get("software")
    if action == "finish" and software in FINISH_PHASES:
        return view
    if (action == "restart" and software == "restart" and state.get("phase") == "ready"
            and state.get("setup_update") is True and not os.path.lexists(OFFLINE)):
        return view
    raise ValueError("The first-run update does not allow this action")


def setup_restart(state, argument):
    uid, _, session = (argument or "").partition(":")
    if not re.fullmatch(r"[0-9]{4,5}", uid) or not 1000 <= int(uid) < 60000:
        raise ValueError("Invalid first-run account")
    if SETUP_DONE.is_file():
        raise ValueError("System setup is already complete")
    view = setup_admit(state, "restart")
    try:
        # Account settings are already committed. This flag contains no secrets
        # and only makes the same account reopen the update page after login.
        (ROOT / f"resume-{uid}").touch(mode=0o644)
        state["setup_boot"] = BOOT_ID.read_text().strip()
        write(STATE, state)
        setup_status(view["drivers"], "restarting")
        OFFLINE.symlink_to(ROOT)
        reboot(session or None)
    except (OSError, ValueError, subprocess.SubprocessError):
        if ours():
            OFFLINE.unlink()
        state["phase"] = "available"
        state.pop("setup_boot", None)
        state.pop("setup_update", None)
        write(STATE, state)
        setup_status(view["drivers"], "restart-failed")
        raise


def setup_stopped(state):
    view = read(SETUP, {})
    if view.get("software") == "restarting":
        return
    drivers = view.get("drivers", "failed")
    if drivers in {"checking", "installing"}:
        drivers = setup_drivers_after_error()
    setup_status(drivers, "failed" if coherent_packages(state) else "repair")


def setup_drivers_after_error():
    info = read(DRIVER_DIR / "status.json", {})
    return "required-failed" if info.get("desktop_required") is True else "failed"


def main(action, argument=None):
    if os.getuid() != 0:
        raise PermissionError("Yu OS updates require root")
    if action == "offline-pending":
        sys.exit(0 if ours() else 1)
    if action == "finish-offline":
        if OFFLINE_STARTED.exists():
            if ours():
                OFFLINE.unlink()
            run("/usr/bin/systemctl", "--no-block", "reboot", timeout=8)
        return
    if action == "status":
        status()
        return
    if action == "setup-stop" and os.environ.get("SERVICE_RESULT") == "success":
        return
    ROOT.mkdir(mode=0o755, exist_ok=True)
    with (ROOT / "transaction.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        state = read(STATE, {"phase": "unchecked"})
        settings = policy()
        if action == "setup":
            setup_update(state)
        elif action == "setup-stop":
            setup_stopped(state)
        elif action == "setup-admit":
            setup_admit(state, argument)
        elif action == "setup-complete":
            setup_admit(state, "finish")
            SETUP_DONE.touch(mode=0o644)
        elif action == "setup-restart":
            setup_restart(state, argument)
        elif action in {"automatic-on", "automatic-off", "restart-on", "restart-off"}:
            if action.startswith("automatic-"):
                settings["automatic_updates"] = action == "automatic-on"
                if not settings["automatic_updates"]:
                    settings["automatic_restart"] = False
            else:
                if action == "restart-on" and not settings["automatic_updates"]:
                    raise ValueError("Enable automatic updates before automatic restart")
                settings["automatic_restart"] = action == "restart-on"
            write(POLICY, settings)
        elif action == "cancel":
            if ours():
                OFFLINE.unlink()
                state["phase"] = "available"
                write(STATE, state)
                clear_archives()
        elif action == "reboot":
            reboot(argument)
        elif action in {"check", "prepare", "automatic", "offline"}:
            if action == "automatic" and not settings["automatic_updates"]:
                return
            if action == "automatic" and state.get("phase") == "ready" and state.get("setup_update"):
                return
            if action == "offline":
                if not ours():
                    return
                OFFLINE_STARTED.touch(mode=0o600)
                # Avoid retrying an interrupted dpkg transaction at every boot.
                OFFLINE.unlink()
            elif os.path.lexists(OFFLINE):
                if action == "automatic":
                    automatic_restart(settings)
                return
            if action != "offline" and state.get("phase") in {"installing", "install-failed"}:
                # Do not silently resume an unconfirmed dpkg transaction.
                if action == "automatic":
                    return
                if action != "check" or run("/usr/bin/dpkg", "--audit", capture=True, timeout=15).strip():
                    state["error"] = "Review the interrupted install and repair dpkg before checking again"
                    write(STATE, state)
                    raise ValueError(state["error"])
            if action == "prepare" and state.get("phase") != "available":
                raise ValueError("Check the signed Yu OS channel before preparing updates")
            try:
                options = apt_options()
                if action == "offline":
                    offline(state, options)
                elif action == "prepare":
                    prepare(state, options)
                else:
                    check(state, options)
                    if action == "automatic" and state["phase"] == "available":
                        prepare(state, options)
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                state.update(phase="install-failed" if action == "offline" else "failed",
                             error=str(error) if isinstance(error, ValueError)
                             else "See the Yu OS update service journal for details")
                write(STATE, state)
                raise
            if action == "automatic":
                automatic_restart(settings)
        else:
            raise ValueError("Invalid Yu OS update action")


if __name__ == "__main__":
    try:
        main(*sys.argv[1:])
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        sys.exit(str(error))
